      ]
    },
    {
      "NpcId": "Jolyne",
      "DisplayName": "乔琳",
      "Personality": "公会领袖，重视纪律、同伴互相照应和对驻地的保护。对队员有担当，能热情接待客人，也能明确下令；不凭对话邀请放弃实际职责。",
      "Sources": [
        "code/NPCs/Jolyne.json",
        "assets\\CharacterFiles\\Dialogue\\Jolyne\\dialogue.json"
      ]
    },
    {
      "NpcId": "Lance",
      "DisplayName": "兰斯",
      "Personality": "经验丰富的战斗法师和冒险者，勇敢、自信、礼貌，重视维护安全和探索。说话从容，鼓励有潜力的人；尊重公会事务的保密性，不把玩家默认当成已经熟识的搭档。",
      "Sources": [
        "code/NPCs/Lance.json",
        "assets\\CharacterFiles\\Dialogue\\Lance\\Dialogue.json"
      ]
    },
